// Cloudflare deployment for the web client.
//
// An **assets-only** Worker: there is an `assets` block and deliberately no
// `main`, so the files are served as static assets without a Worker invocation
// per request. Static asset requests are unmetered, which is why §6.6 lists
// hosting as the one line in its budget table that is not a constraint.
//
// # No Durable Object, on purpose
//
// §6.6's architectural rule is that the Lobby DO must not stay alive during a
// match — failure mode 5, and one that will never show up in testing with two
// people and one match. Nothing here can violate it, because there is no DO at
// all yet. Signalling, TURN and the Lobby/Directory/Budget-Gatekeeper DOs belong
// to the phase that designs that rule in rather than checking for it afterwards.
//
// # Divergence from §6.6
//
// The spec says "static assets on Cloudflare **Pages**". This uses **Workers
// Static Assets** instead: it is the current successor for this case, equally
// unmetered for static requests, and it keeps one platform for when signalling
// arrives — rather than Pages for the assets plus a Worker beside it.
{
  "$schema": "node_modules/wrangler/config-schema.json",

  // Must match the Workers project the repository is already connected to. A
  // different name here silently creates a second project and leaves the
  // original deploy red.
  "name": "amigo-diomano",

  "compatibility_date": "2026-08-04",

  // Deliberately absent: `account_id`. It arrives as CLOUDFLARE_ACCOUNT_ID in the
  // environment, so an account identifier does not sit in a public repository.

  "assets": {
    // What `just build-web` produces: index.html, the hashed JS chunks, and
    // diomano.wasm copied out of web/public.
    "directory": "./web/dist",

    // A real 404 for unknown paths, rather than "single-page-application".
    // There is exactly one route and no client-side router, so answering
    // /anything with index.html would claim a structure the app does not have.
    "not_found_handling": "none"
  },

  "observability": {
    "enabled": true
  }
}
